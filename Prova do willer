SELECT
    c.endereco_wallet,
    c.rede_blockchain,
    c.saldo_usd,
    i.nome AS nome_investidor,
    i.cpf
FROM carteiras c
INNER JOIN investidores i
    ON c.investidor_id = i.id
WHERE c.status IN ('Ativa', 'Em Analise');
SELECT * FROM vw_painel_carteiras;


SELECT
    co.nome_exchange,
    COALESCE(SUM(t.valor_pago), 0) AS total_movimentado
FROM corretoras co
INNER JOIN criptomoedas cr
    ON co.id = cr.corretora_id
LEFT JOIN transacoes_cripto t
    ON cr.id = t.criptomoeda_id
GROUP BY
    co.id,
    co.nome_exchange
ORDER BY total_movimentado DESC;


SELECT
    ca.endereco_wallet,
    cr.nome_moeda,
    t.quantidade,
    cr.preco_unitario_usd,
    t.valor_pago,
    t.data_transacao
FROM transacoes_cripto t
INNER JOIN carteiras ca
    ON t.carteira_id = ca.id
INNER JOIN criptomoedas cr
    ON t.criptomoeda_id = cr.id
WHERE t.valor_pago > 500.00
ORDER BY t.valor_pago DESC;


CREATE OR REPLACE VIEW vw_painel_carteiras AS
SELECT
    ca.endereco_wallet,
    ca.rede_blockchain,
    ca.status,
    ca.saldo_usd,
    i.nome AS nome_investidor,
    i.cpf
FROM carteiras ca
INNER JOIN investidores i
    ON ca.investidor_id = i.id;


CREATE OR REPLACE VIEW vw_investimento_total_carteiras AS
SELECT
    ca.id AS carteira_id,
    ca.endereco_wallet,
    ca.saldo_usd,
    COUNT(t.id) AS quantidade_total_transacoes,
    COALESCE(SUM(t.valor_pago), 0) AS custo_total_acumulado
FROM carteiras ca
LEFT JOIN transacoes_cripto t
    ON ca.id = t.carteira_id
GROUP BY
    ca.id,
    ca.endereco_wallet,
    ca.saldo_usd;


