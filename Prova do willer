CREATE TABLE investidores (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL UNIQUE,
    nivel_experiencia INT DEFAULT 0,
    CHECK (nivel_experiencia >= 0)
);


CREATE TABLE carteiras (
    id SERIAL PRIMARY KEY,
    investidor_id INT NOT NULL,
    endereco_wallet VARCHAR(100) NOT NULL UNIQUE,
    rede_blockchain VARCHAR(30) NOT NULL,
    saldo_usd DECIMAL(15,2) DEFAULT 0.00,
    status VARCHAR(20) NOT NULL,

    FOREIGN KEY (investidor_id)
        REFERENCES investidores(id),

    CHECK (saldo_usd >= 0),
    CHECK (status IN (
        'Ativa',
        'Em Analise',
        'Bloqueada',
        'Pausada'
    ))
);


CREATE TABLE corretoras (
    id SERIAL PRIMARY KEY,
    nome_exchange VARCHAR(100) NOT NULL,
    cnpj CHAR(14) NOT NULL UNIQUE,
    email_suporte VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE criptomoedas (
    id SERIAL PRIMARY KEY,
    corretora_id INT NOT NULL,
    nome_moeda VARCHAR(50) NOT NULL,
    preco_unitario_usd DECIMAL(15,2) NOT NULL,
    categoria VARCHAR(20) NOT NULL,

    FOREIGN KEY (corretora_id)
        REFERENCES corretoras(id),

    CHECK (preco_unitario_usd > 0),
    CHECK (categoria IN (
        'Layer1',
        'DeFi',
        'Memecoin',
        'Stablecoin'
    ))
);


CREATE TABLE transacoes_cripto (
    id SERIAL PRIMARY KEY,
    carteira_id INT NOT NULL,
    criptomoeda_id INT NOT NULL,
    quantidade DECIMAL(15,6) NOT NULL,
    valor_pago DECIMAL(15,2) NOT NULL,
    data_transacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (carteira_id)
        REFERENCES carteiras(id),

    FOREIGN KEY (criptomoeda_id)
        REFERENCES criptomoedas(id),

    CHECK (quantidade > 0),
    CHECK (valor_pago > 0)
);

