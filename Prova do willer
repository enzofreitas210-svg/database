SELECT
    v.numero_voo,
    v.origem,
    v.destino,
    a.modelo,
    p.nome AS piloto
FROM voos v
JOIN aeronaves a
    ON v.aeronave_id = a.id
JOIN pilotos p
    ON v.piloto_id = p.id
WHERE v.status IN ('Agendado', 'Em Voo');




SELECT
    classe,
    SUM(valor) AS total_arrecadado
FROM passagens
GROUP BY classe;


SELECT
    p.nome AS passageiro,
    v.numero_voo,
    pa.assento,
    pa.valor
FROM passagens pa
JOIN passageiros p
    ON pa.passageiro_id = p.id
JOIN voos v
    ON pa.voo_id = v.id
WHERE pa.classe = 'Executiva'
  AND pa.valor > 800
ORDER BY pa.valor DESC;




CREATE VIEW vw_painel_aeroporto AS
SELECT
    v.numero_voo,
    v.data_hora,
    v.origem,
    v.destino,
    a.modelo,
    a.codigo_cauda,
    v.status
FROM voos v
JOIN aeronaves a
    ON v.aeronave_id = a.id;




CREATE VIEW vw_faturamento_por_voo AS
SELECT
    v.id AS voo_id,
    v.numero_voo,
    v.destino,
    COUNT(pa.id) AS quantidade_passageiros,
    COALESCE(SUM(pa.valor), 0) AS receita_total
FROM voos v
LEFT JOIN passagens pa
    ON v.id = pa.voo_id
GROUP BY
    v.id,
    v.numero_voo,
    v.destino;

